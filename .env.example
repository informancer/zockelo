# =============================================================================
# Zockelo — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Lines starting with # are comments and are ignored.
#
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Application will refuse to start without these in production
# -----------------------------------------------------------------------------

# Phoenix secret key base — generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Main application database (Ecto/Postgres)
# Format: ecto://USER:PASS@HOST:PORT/DATABASE
DATABASE_URL=ecto://zockelo:changeme@db:5432/zockelo_prod

# EventStore database (separate Postgres DB on same instance)
# Format: ecto://USER:PASS@HOST:PORT/DATABASE
EVENT_STORE_URL=ecto://zockelo:changeme@db:5432/zockelo_eventstore_prod

# Cloak encryption key (AES-256-GCM) — generate with:
#   :crypto.strong_rand_bytes(32) |> Base.encode64() |> IO.puts()
CLOAK_KEY=

# Application hostname (used for URL generation and magic links)
# Do NOT include protocol or trailing slash — e.g. foosball.example.com
PHX_HOST=foosball.example.com

# SMTP relay hostname — required for sending magic links and notifications
SMTP_HOST=smtp.example.com

# Email address used in the From: header of all outgoing emails
SMTP_FROM=noreply@foosball.example.com

# Docker image to deploy (set by setup.sh, override to pin a version)
IMAGE=ghcr.io/informancer/zockelo:latest

# -----------------------------------------------------------------------------
# OPTIONAL — Have sensible defaults; adjust as needed
# -----------------------------------------------------------------------------

# SMTP port (default: 587)
# SMTP_PORT=587

# SMTP authentication credentials (leave blank for unauthenticated relay)
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Postgres connection pool size (default: 10)
# POOL_SIZE=10

# IPv6 database connections (default: false)
# ECTO_IPV6=false

# Trust X-Forwarded-* headers from reverse proxy (set to true behind Caddy)
# REQUIRED when running behind a reverse proxy — do NOT set without one
# TRUST_PROXY_HEADERS=false

# GlitchTip / Sentry DSN for error tracking (silent no-op when unset)
# GLITCHTIP_DSN=

# Grafana admin password — generated by setup.sh, 32+ bytes base64-encoded
# GF_SECURITY_ADMIN_PASSWORD=

# GlitchTip superuser credentials (used by setup.sh for API automation)
# GLITCHTIP_SUPERUSER_EMAIL=admin@example.com
# GLITCHTIP_SUPERUSER_PASSWORD=

# Grafana alert notification email
# GRAFANA_ALERT_EMAIL=

# Grafana alert webhook URL
# GRAFANA_WEBHOOK_URL=

# Server port (default: 4000)
# PORT=4000

# DNS cluster query for multi-node deployments
# DNS_CLUSTER_QUERY=

# Build hash — injected into service worker for cache versioning
# Set automatically by CI to the git short SHA
# BUILD_HASH=dev

# PHX_SERVER=true must be set when running a release (set in Dockerfile entrypoint)
PHX_SERVER=true
